#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
TARGET="$SCRIPT_DIR/../../../scripts/monolith-test-report"
if [[ ! -x "$TARGET" ]]; then
  echo "Error: expected containing Test Engineering plugin script at $TARGET" >&2
  exit 127
fi
exec "$TARGET" "$@"
